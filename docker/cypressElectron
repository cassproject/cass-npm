# Keep this tag in sync with the exact "cypress" version in package.json: the
# image ships the Cypress binary at this version and the ENTRYPOINT runs it, so a
# floating npm range here would silently pair one Cypress with another's binary.
FROM cypress/included:15.19.0
RUN apt-get install xvfb

WORKDIR code
COPY package.json package.json
RUN npm install

COPY ca.crt ca.crt
COPY client.crt client.crt
COPY client.key client.key
COPY index.js index.js
COPY src src
COPY cypressWebpack cypressWebpack
COPY cypressWebpack.config.js cypressWebpack.config.js
ENTRYPOINT cypress run --config-file cypressWebpack.config.js --headless -e CASS_LOOPBACK=${CASS_LOOPBACK},TESTLEVEL=${TESTLEVEL} --spec "**/!(4.schema.test.js)"